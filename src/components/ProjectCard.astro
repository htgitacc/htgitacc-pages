---
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { data } = project;

const hu = lang === 'hu';
const title = hu ? data.title_hu : data.title_en;
const why = hu ? data.why_hu : data.why_en;
const summary = hu ? data.summary_hu : data.summary_en;
const learned = hu ? data.learned_hu : data.learned_en;

// A content-fájlokban a képeket base nélkül, gyökér-relatívan írjuk
// (pl. '/assets/projects/my-anki/kep.jpg') — itt fűzzük hozzá a GitHub
// Pages base-t ('/htgitacc-pages/'), hogy éles buildben is jó legyen a link.
const withBase = (src: string) => `${import.meta.env.BASE_URL}${src.replace(/^\//, '')}`;
const [firstImage, ...moreImages] = data.images.map(withBase);
---

<article class="project-card" class:list={{ 'is-wip': data.wip, 'has-media': !!firstImage }}>
  <div class="project-text">
    <div class="project-heading">
      <h3>{title}</h3>
      {data.wip && <span class="badge badge--wip">{t('badge.wip')}</span>}
    </div>

    {why && <p class="project-why">{why}</p>}
    <p class="project-summary">{summary}</p>
    {learned && (
      <p class="project-learned">
        <span class="label">{t('project.learned')}</span> {learned}
      </p>
    )}

    {(data.tool || data.tech.length > 0) && (
      <ul class="tech-list" aria-label={t('project.tech')}>
        {data.tool && <li class="tool">{data.tool}</li>}
        {data.tech.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    )}

    <div class="project-links">
      {data.demoUrl && (
        <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="link-accent">
          {t('project.demo')} ↗
        </a>
      )}
      {data.repoUrls.map((url, i) => (
        <a href={url} target="_blank" rel="noopener noreferrer">
          {data.repoUrls.length > 1 ? `${t('project.repo')} ${i + 1}` : t('project.repo')} ↗
        </a>
      ))}
      {data.pdfUrls.map((url, i) => (
        <a href={url} target="_blank" rel="noopener noreferrer">
          {data.pdfUrls.length > 1 ? `${t('project.pdf')} ${i + 1}` : t('project.pdf')} ↗
        </a>
      ))}
    </div>
  </div>

  {firstImage && (
    <div class="project-media">
      <button type="button" class="zoomable" data-full={firstImage} aria-label={t('project.zoom')}>
        <img src={firstImage} alt={title} loading="lazy" decoding="async" />
      </button>
      {moreImages.length > 0 && (
        <details class="more-images">
          <summary>{t('project.moreImages')} ({moreImages.length})</summary>
          <div class="more-grid">
            {moreImages.map((src) => (
              <button type="button" class="zoomable" data-full={src} aria-label={t('project.zoom')}>
                <img src={src} alt={title} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </details>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    /* bal oldali arany „selyemszál": a design rendszer díszítő színe */
    border-left: 3px solid var(--accent-2);
  }

  @media (min-width: 900px) {
    .project-card.has-media {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: start;
    }
  }

  .project-card.is-wip {
    border-style: dashed;
  }

  .project-text {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  /* kép nélküli kártyán se legyen túl hosszú a sor */
  .project-card:not(.has-media) .project-text {
    max-width: 48rem;
  }

  .project-heading {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .project-heading h3 {
    margin: 0;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.9rem);
    font-weight: 600;
  }

  .project-why {
    margin: 0;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--text-high);
  }

  .project-summary {
    margin: 0;
    color: var(--text-muted);
  }

  .project-learned {
    margin: 0;
    padding: 0.7rem 0.9rem;
    background: var(--bg-inset);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--text);
  }

  .project-learned .label {
    font-weight: 600;
    color: var(--accent);
  }

  .tech-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: 0;
  }

  .tech-list li {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--forest-strong);
    background: var(--accent-low);
    border-radius: 999px;
    padding: 0.2em 0.7em;
  }

  .tech-list li.tool {
    color: var(--accent-2);
    background: transparent;
    border: 1px solid var(--accent-2);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .project-links:empty {
    display: none;
  }

  .project-links a {
    text-decoration: none;
  }

  .project-links a.link-accent {
    color: var(--accent);
  }

  .project-media {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .zoomable {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-inset);
    cursor: zoom-in;
  }

  .zoomable img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .zoomable:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .more-images summary {
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }

  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.6rem;
    margin-top: 0.6rem;
  }
</style>
