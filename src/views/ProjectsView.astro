---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { siteConfig } from '../site.config';

interface Props {
  /** locale-prefix nélküli útvonal, amin ez a nézet ki van téve (a nyelvváltóhoz kell) */
  path?: string;
}
const { path = '/' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});

const title = `${t('projects.title')} — ${siteConfig.displayName}`;
const description =
  lang === 'hu'
    ? 'Publikus projektjeim és bemutatóim.'
    : 'My public projects and showcases.';
---

<BaseLayout title={title} description={description} path={path}>
  <section class="container page-header">
    <span class="eyebrow">{t('projects.eyebrow')}</span>
    <h1>{t('projects.title')}</h1>
    <p class="intro">{t('projects.intro')}</p>
    <p class="focus">{t('projects.focus')}</p>
    <p class="wip-note">
      <span aria-hidden="true">🚧</span> {t('projects.wip')}
    </p>
  </section>

  <section class="container projects-grid">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding-block: clamp(2rem, 4vw, 4rem) 1rem;
    max-width: 46rem;
  }
  .intro {
    color: var(--text-muted);
  }
  .focus {
    color: var(--text);
    font-size: 1.02rem;
  }
  .wip-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--forest-strong);
    background: color-mix(in srgb, var(--forest) 10%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--forest) 30%, var(--border));
    border-radius: 999px;
    padding: 0.4em 0.9em;
    margin-top: 0.5rem;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding-bottom: 4rem;
  }
</style>
