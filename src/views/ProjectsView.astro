---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { siteConfig } from '../site.config';

interface Props {
  /** locale-prefix nélküli útvonal, amin ez a nézet ki van téve (a nyelvváltóhoz kell) */
  path?: string;
}
const { path = '/' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// A 'projects.focus' szöveg üres sorral elválasztott bekezdésekből áll
// (ui.ts-ben '\n\n'-nel), itt bontjuk külön <p> elemekre.
const focusParagraphs = t('projects.focus').split('\n\n');

// A tartalék (draft) kártyák nem jelennek meg, amíg nincsenek kitöltve.
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = allProjects.sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.order - b.data.order;
});

// A számok és a technológia-felhő a kártyákból számolódnak, hogy új projekt
// felvételekor ne kelljen kézzel frissíteni őket. A felhő gyakoriság szerint
// rendez: ami több projektben szerepel, az előrébb és nagyobb.
const techCount = new Map<string, number>();
for (const { data } of projects) {
  for (const tech of data.tech) techCount.set(tech, (techCount.get(tech) ?? 0) + 1);
}
for (const extra of siteConfig.extraTech) {
  const known = [...techCount.keys()].some((k) => k.toLowerCase() === extra.toLowerCase());
  if (!known) techCount.set(extra, 1);
}
const sortedCloud = [...techCount.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
// a megadott blokkok tagjai egymás mellé, a blokk első tagjának helyére kerülnek
const techCloud = sortedCloud.flatMap((entry) => {
  const block = siteConfig.techBlocks.find((b) => b.includes(entry[0]));
  if (!block) return [entry];
  const first = sortedCloud.find(([name]) => block.includes(name))![0];
  if (first !== entry[0]) return [];
  return block.map((name) => sortedCloud.find(([n]) => n === name)).filter((e): e is [string, number] => !!e);
});
const tools = new Set(projects.flatMap(({ data }) => data.tools));

const title = `${t('projects.title')} — ${siteConfig.displayName}`;
const description =
  lang === 'hu'
    ? 'Projektjeim az AI-tanulás útján: miért születtek, mit csinálnak, mit tanultam belőlük.'
    : 'My projects along the AI learning path: why they were made, what they do, what I learned.';
---

<BaseLayout title={title} description={description} path={path}>
  <section class="container page-header">
    <span class="eyebrow">{t('projects.eyebrow')}</span>
    <h1>{t('projects.title')}</h1>
    <p class="intro">{t('projects.intro')}</p>
    {focusParagraphs.map((paragraph) => (
      <p class="focus">{paragraph}</p>
    ))}
  </section>

  <section class="container overview" aria-label={t('projects.overview')}>
    <dl class="stats">
      <div>
        <dt>{t('stats.projects')}</dt>
        <dd>{projects.length}</dd>
      </div>
      <div>
        <dt>{t('stats.technologies')}</dt>
        <dd>{techCloud.length}</dd>
      </div>
      {/* egyetlen eszköznél a szám keveset mond; a Codex/Cursor kártyákkal jelenik meg */}
      {tools.size > 1 && (
        <div>
          <dt>{t('stats.tools')}</dt>
          <dd>{tools.size}</dd>
        </div>
      )}
    </dl>
    <ul class="tech-cloud" aria-label={t('stats.technologies')}>
      {techCloud.map(([tech, count]) => (
        <li class:list={{ 'is-frequent': count >= 3, 'is-common': count === 2 }}>{tech}</li>
      ))}
    </ul>
    <p class="models-label">{t('stats.models')}</p>
    <ul class="models" aria-label={t('stats.models')}>
      {siteConfig.llmModels.map((model) => <li>{model}</li>)}
    </ul>
  </section>

  <div class="container">
    <div class="thread-divider"></div>
  </div>

  <section class="container projects-list">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </section>

  <dialog class="lightbox" id="lightbox" aria-label={t('project.zoom')}>
    <form method="dialog">
      <button class="lightbox-close" aria-label={t('lightbox.close')}>×</button>
    </form>
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  // Egyetlen közös <dialog> az összes kártya képéhez: kattintásra nagyban
  // nyílik, Esc-re vagy a háttérre kattintva bezárul.
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const image = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('.zoomable').forEach((button) => {
    button.addEventListener('click', () => {
      if (!dialog || !image) return;
      image.src = button.dataset.full ?? '';
      image.alt = button.querySelector('img')?.alt ?? '';
      dialog.showModal();
    });
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .page-header {
    padding-block: clamp(2rem, 4vw, 4rem) 1rem;
  }
  /* a szöveg olvasható szélességű, de a blokk a konténer bal széléhez igazodik,
     egy vonalban az áttekintéssel és a kártyákkal */
  .page-header > * {
    max-width: 46rem;
  }
  .intro {
    color: var(--text-high);
    font-size: 1.1rem;
  }
  .focus {
    color: var(--text-muted);
    font-size: 1.02rem;
  }

  .overview {
    display: grid;
    gap: 1.5rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    margin: 0;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    line-height: 1;
    color: var(--accent);
    /* a Cormorant alapból régies (oldstyle) számjegyeket rajzol, az „1” „I”-nek látszik */
    font-variant-numeric: lining-nums;
  }
  .tech-cloud {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    max-width: 52rem;
  }
  .tech-cloud li {
    font-size: 0.8rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2em 0.75em;
  }
  .tech-cloud li.is-common {
    color: var(--text);
    font-size: 0.88rem;
  }
  .tech-cloud li.is-frequent {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    font-size: 0.95rem;
    font-weight: 600;
  }

  .models-label {
    margin: 0.5rem 0 -0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .models {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    padding: 0;
    margin: 0;
    max-width: 52rem;
    color: var(--text);
    font-size: 0.9rem;
  }

  .projects-list {
    display: grid;
    gap: 2rem;
    padding-bottom: 4rem;
  }

  .lightbox {
    max-width: min(96vw, 1400px);
    max-height: 94vh;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-inset);
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.8);
  }
  .lightbox img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }
  .lightbox form {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
  }
  .lightbox-close {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--heading);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
